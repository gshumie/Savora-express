PORT=3000
NODE_ENV="development"

# Database Connection (PostgreSQL on Neon recommended)
# DATABASE_URL: Pooled connection string used for serverless app runtime
# DIRECT_URL: Direct unpooled connection string required by Prisma CLI migrations
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/savora?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/savora?sslmode=require"

# Security Secrets (Must be at least 32 characters in production)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-private-random-secret-of-at-least-32-characters"
PAYMENT_STATUS_TOKEN_SECRET="replace-with-a-private-random-token-of-at-least-32-characters"

# Payment Gateway Configuration (Chapa ETB)
PAYMENT_PROVIDER="chapa"
CHAPA_SECRET_KEY="CHASECK_TEST-your-chapa-secret-key-here"
CHAPA_WEBHOOK_SECRET="your-chapa-webhook-secret-hash"
CHAPA_ENVIRONMENT="test"
CHAPA_CURRENCY="ETB"
ETB_PRICES_APPROVED="true"

# Application URLs (Production: https://your-domain.vercel.app)
CLIENT_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"

# Real-Time Order Notifications: Telegram Bot API
TELEGRAM_BOT_TOKEN="123456789:ABCDEFyour_telegram_bot_token"
TELEGRAM_CHAT_ID="-1001234567890"

# Real-Time Order Notifications: Email Alerts (SMTP / Nodemailer / Resend)
ADMIN_NOTIFY_EMAIL="orders@savoraexpress.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
RESEND_API_KEY=""

# Optional Seed Guard (Non-production only)
ALLOW_DATABASE_SEEDING="false"
