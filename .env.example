PORT=3000
# Set both database URLs: DATABASE_URL is the runtime connection, DIRECT_URL is for Prisma CLI.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/savora_express?schema=public"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/savora_express?schema=public"
# Generate a private value locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never use a shared or example value as your JWT secret.
JWT_SECRET=""
PAYMENT_STATUS_TOKEN_SECRET="replace-with-a-private-random-value-of-at-least-32-characters"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
PAYMENT_PROVIDER="demo"
STRIPE_CURRENCY="USD"
ALLOW_DATABASE_SEEDING="false"
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""
CHAPA_ENVIRONMENT="test"
CHAPA_CURRENCY="ETB"
ETB_PRICES_APPROVED="false"
CLIENT_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
