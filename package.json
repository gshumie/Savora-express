{
  "name": "savora-express",
  "version": "1.0.0",
  "description": "Savora Express restaurant website with Express.js API and PostgreSQL database",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "restaurant",
    "express",
    "postgresql",
    "prisma",
    "savora"
  ],
  "author": "Savora Express",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "6.12.0",
    "stripe": "^17.0.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/client@6.12.0": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true
  }
}
